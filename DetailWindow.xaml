<Window x:Class="NotchSense.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="260"
        Height="154">
  <Canvas x:Name="Surface" Width="260" Height="154">
    <Border x:Name="Card" Width="248" Height="154" Background="#FF0A0A0A" CornerRadius="16" Padding="16">
      <StackPanel>
        <TextBlock x:Name="HeaderText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,13" />
        <DockPanel>
          <TextBlock x:Name="CardLabel" FontSize="11" Foreground="#B7B7B7" DockPanel.Dock="Left" />
          <TextBlock x:Name="CardValue" FontSize="11" Foreground="#D7D7D7" HorizontalAlignment="Right" />
        </DockPanel>
        <Border Height="4" Background="#3A3A3A" CornerRadius="2" Margin="0,6,0,5">
          <Border x:Name="UsageFill" Height="4" HorizontalAlignment="Left" Background="#28E07B" CornerRadius="2" />
        </Border>
        <TextBlock x:Name="UsageText" FontSize="11" Foreground="#B7B7B7" Margin="0,0,0,12" />
        <Grid x:Name="DetailsGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock x:Name="PrimaryCaption" FontSize="10" Foreground="#858585" />
            <TextBlock x:Name="PrimaryValue" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel x:Name="SecondaryPanel" Grid.Column="1">
            <TextBlock x:Name="SecondaryCaption" FontSize="10" Foreground="#858585" />
            <TextBlock x:Name="SecondaryValue" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
    <Polygon x:Name="Tail" Fill="#FF0A0A0A" />
  </Canvas>
</Window>
